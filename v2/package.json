{
  "name": "emilia-pixel-adventure-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bundle": "vitest run --config vitest.bundle.config.ts",
    "test:e2e": "npm run build && playwright test",
    "maps:export": "node tools/export-legacy-maps.mjs",
    "save:fingerprint": "node tools/save-fingerprint.mjs",
    "art:build": "node tools/art/build.mjs",
    "art:sheet": "node tools/art/contact-sheet.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.1.0"
  }
}
